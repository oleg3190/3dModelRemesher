	$(MAKE) $(MAKESILENT) -f CMakeFiles/qremesh_core.dir/build.make CMakeFiles/qremesh_core.dir/src/stages/stage6_opt.cpp.o
	$(MAKE) $(MAKESILENT) -f CMakeFiles/qremesh_core_static.dir/build.make CMakeFiles/qremesh_core_static.dir/src/stages/stage6_opt.cpp.o
.PHONY : src/stages/stage6_opt.cpp.o

src/stages/stage6_opt.i: src/stages/stage6_opt.cpp.i
.PHONY : src/stages/stage6_opt.i

# target to preprocess a source file
src/stages/stage6_opt.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/qremesh_core.dir/build.make CMakeFiles/qremesh_core.dir/src/stages/stage6_opt.cpp.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/qremesh_core_static.dir/build.make CMakeFiles/qremesh_core_static.dir/src/stages/stage6_opt.cpp.i
.PHONY : src/stages/stage6_opt.cpp.i

src/stages/stage6_opt.s: src/stages/stage6_opt.cpp.s
.PHONY : src/stages/stage6_opt.s

# target to generate assembly for a file
src/stages/stage6_opt.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/qremesh_core.dir/build.make CMakeFiles/qremesh_core.dir/src/stages/stage6_opt.cpp.s
	$(MAKE) $(MAKESILENT) -f CMakeFiles/qremesh_core_static.dir/build.make CMakeFiles/qremesh_core_static.dir/src/stages/stage6_opt.cpp.s
.PHONY : src/stages/stage6_opt.cpp.s

